    "Field": {
      "description": "One extracted value with its source evidence. value is null when not determinable.\n\nunit: for quantities, the counting unit as stated (e.g. \"pen\", \"tablet\"). For prices,\n\"<CURRENCY>/<counting unit as stated in the email>\", e.g. \"USD/pen\", \"USD/carton\",\n\"USD/tablet\". Extraction records the basis as stated and never converts between bases;\nconversion is a validator job using pack size.",
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "raw": {
